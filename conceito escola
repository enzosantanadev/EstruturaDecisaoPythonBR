nota1 = float(input("Digite a primeira nota: "))
nota2 = float(input("Digite a segunda nota: "))


media = (nota1 + nota2) / 2


tabela = {
    (9.0, 10.0): ("A", "APROVADO"),
    (7.5, 9.0): ("B", "APROVADO"),
    (6.0, 7.5): ("C", "APROVADO"),
    (4.0, 6.0): ("D", "REPROVADO"),
    (0.0, 4.0): ("E", "REPROVADO"),
}

for (minimo, maximo), (conceito, status) in tabela.items():
    if minimo <= media < maximo:
        break


print(f"media: {media:.2f}")
print(f"conceito: {conceito}")
print(f"status: {status}")
